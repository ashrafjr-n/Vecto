{
	// Cloudflare Worker with static assets (NOT Pages). Workers Builds runs
	// `npm run build` then `npx wrangler deploy` on every push, which reads this file.
	"name": "vecto",
	"main": "worker/index.js",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./dist/",
		"binding": "ASSETS",
		// Deep links (/methodology, /analyze) get index.html instead of a 404.
		"not_found_handling": "single-page-application",
		// Only API routes reach the script; everything else is served as an asset.
		"run_worker_first": [
			"/api/*"
		]
	},
	// Accounts, sessions and AI usage (migrations/0001_init.sql). Created with
	// `npx wrangler d1 create vecto-db` — paste the id it prints into database_id.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vecto-db",
			"database_id": "b239a7b3-0005-4e21-ae4e-5a96e29007d1"
		}
	],
	"vars": {
		// Public by design — the client id is not a secret. GITHUB_CLIENT_SECRET and
		// EVAL_TOKEN are Worker SECRETS and never appear in this file.
		"GITHUB_CLIENT_ID": "Ov23liG7ih99YVhgZ0GG",
		// Every origin this deployment answers to. The browser sends Origin on any
		// POST, so this is the CSRF guard beside the SameSite=Lax cookie. In dev,
		// .dev.vars overrides it with http://localhost:3001.
		"ALLOWED_ORIGINS": "https://vecto.aannaelj.workers.dev",
		// 3 deeper reviews per user per DAY (one dataset = one review, however many
		// model requests it needs internally), with a per-user monthly ceiling behind
		// it so a daily reset cannot compound to ~90/month. DAILY_AI_BUDGET is the one
		// that actually bounds cost: 30 requests a day across ALL users, against an
		// upstream free tier of 50/day, leaving ~20 for the owner's eval runs.
		"FREE_ANALYSES_PER_DAY": "3",
		"MONTHLY_ANALYSIS_CEILING": "25",
		"DAILY_AI_BUDGET": "30",
		// Gemini's own daily allowance (worker/usage.js keeps a counter per provider).
		// Its free tier gives Flash-Lite about 500 requests a day; 450 leaves room for
		// the owner's eval runs. Every request sent counts, answered or not.
		"GEMINI_DAILY_BUDGET": "450",
		// PRIMARY provider since 2026-09-26, tried before AI_MODELS, one model at a time
		// in this order (each model has its own free allowance). Used only when the
		// GEMINI_API_KEY secret is set; empty string = Gemini off, OpenRouter alone.
		"GEMINI_MODELS": "gemini-2.5-flash-lite,gemini-3.5-flash-lite",
		// The FALLBACK provider since 2026-09-26: reached only when every Gemini model
		// failed or Gemini's day is spent. Tried in order by OpenRouter's `models` fallback. Each is the free variant of a
		// paid model, so dropping ":free" later changes billing, not behaviour.
		// Empty string = AI switched off (the endpoint answers 503 ai_disabled).
		//
		// ONE model since 2026-09-18 (vecto-plan item 20). super answered leakage files in
		// 1-7 s with ZERO findings on documented leaks (corpus, validation and test all show
		// it) and gemma has never answered a single request (overloaded, then 429). Measured:
		// leakage 87% -> 92% on ultra alone. The cost is latency (median 70-95 s) and no
		// fallback: an overloaded ultra is now an upstream_error, which is free and retryable.
		"AI_MODELS": "nvidia/nemotron-3-ultra-550b-a55b:free"
	}
	// OPENROUTER_API_KEY and GEMINI_API_KEY are Worker SECRETS (dashboard or
	// `wrangler secret put`), and `.dev.vars` locally — never a var here, never VITE_*.
}