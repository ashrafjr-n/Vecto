node_modules/
.env.local

CLAUDE.md
vibe.md
frontend.md
.claude/

vecto-docs.md

# glob, not a literal name: the original literal "reactjs-principles.md" failed to
# match the real on-disk "reactjs-principles .md" (stray space) and it got tracked.
*principles*.md
# Vite dep pre-bundle cache — generated on every dev run, 12MB, never shipped
.vite/
# Production build — Cloudflare Workers Builds runs `npm run build` on every push and
# deploys dist/ itself, so a committed copy could only ever be stale.
dist/

# Dataset test reports written by tools/report.mjs — local test artifacts, not build output
reports/
# Test datasets — large third-party CSVs, never part of the repo
forTesting/

# Local knowledge vault (Obsidian) — notes about the project, not part of the app
vecto-brain/
